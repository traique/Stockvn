# ====== BIẾN CHO BOTKEEP – bot v3.3.0 (chạy độc lập; trong Stockvn dùng biến ALT_… trên panel Cổ phiếu) ======
# Nhập trong panel Botkeep → Environment → khung .env (Saved configuration).
# Biến đã lưu hiện dạng TÊN="__BOTKEEP_KEEP_SECRET_TÊN__": GIỮ NGUYÊN dòng đó để giữ giá trị.
# KHÔNG dán dòng có <...> vào panel – thay <...> bằng giá trị thật, hoặc bỏ dòng đó.
#
# CHỈ CẦN KHAI các biến dưới đây. Mọi thông số giao dịch (MIN_SCORE, TP1_R, rủi ro, ADX…) đã có
# mặc định tốt nhất trong code và tự cập nhật mỗi khi tải zip bản mới → KHÔNG khai trên panel,
# nếu khai thì giá trị trên panel sẽ giữ cố định, không theo bản mới.
# Kiểm tra sau khi restart: log có dòng "Thông số đang dùng: MIN_SCORE=… RISK=…".

# ---------- Chế độ & thông tin riêng ----------
MODE=paper
PAPER_START_BALANCE=10

# v3.3: đã bỏ hồ sơ "test gắt" (RISK_PER_TRADE=0.10, MAX_TOTAL_RISK=0.20, MAX_DAILY_LOSS=0.30, MAX_DRAWDOWN=0.50) – dán
# nguyên file vào panel là thành 10% vốn mỗi lệnh. Rủi ro dùng mặc định trong code (3%/lệnh, tổng 5%, cầu dao 12%/ngày, 30% DD).
I_UNDERSTAND_THE_RISK=no
# v3.3: 4 tuần đo sau bản sửa lỗi – bộ tự học chỉ ĐỀ XUẤT (chờ duyệt), không tự đổi tham số trong lúc đang đo
LEARN_MODE=suggest
INSTANCE_NAME=crypto
TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_URL=https://okx.bot-keep.xyz
SUPPORT_EMAIL=

# ---------- Web dashboard ----------
DASHBOARD_USER=admin
DASHBOARD_PASS=<mật khẩu dashboard>

# ---------- Telegram ----------
TELEGRAM_TOKEN=<token @BotFather>
TELEGRAM_CHAT_ID=<chat id>

# ---------- AI ----------
AI_PROVIDER_ORDER=9router,openrouter
NINEROUTER_BASE_URL=http://node3.botkeep.cloud:36004/v1
NINEROUTER_API_KEY=<sk-uni-... của 9Router>
NINEROUTER_MODEL=auto
OPENROUTER_API_KEY=<key OpenRouter>

# ---------- OKX (chỉ khi chạy thật MODE=live) ----------
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ---------- Zoom Team Chat ----------
ZOOM_CLIENT_ID=<Client ID>
ZOOM_CLIENT_SECRET=<Client Secret>
ZOOM_BOT_JID=<Bot JID>
ZOOM_SECRET_TOKEN=<Secret Token>
# ZOOM_ACCOUNT_ID: để trống/xoá – bot tự lấy từ Zoom (KHÔNG điền "Account No." 10 chữ số ở zoom.us/account)
ZOOM_ACCOUNT_ID=
# Tuỳ chọn: JID nhận thông báo cố định (chỉ khi nút "Gửi thử" trên web vẫn báo lỗi)
ZOOM_TO_JID=

# ---------- Postgres dùng chung trên Supabase (tuỳ chọn; trống = SQLite trên server) ----------
# Chạy song song Render: không dùng – đã bỏ Render (không khai PEER_URL).
DATABASE_URL=

# ---------- TUỲ CHỌN (chỉ thêm khi muốn khác mặc định) ----------
# Mặc định trong code bản này (v3.3): MIN_SCORE=5.0 MIN_ADX=20 HTF_MIN_ADX=18 MAX_EXT_ATR=1.0 MIN_VOL_RATIO=0.7
# BTC_GATE_CHG=0.3 CHASE_1H_PCT=0.5 CLIMAX_VOL=1.5 LATE_TREND_ADX=35 BREAKOUT_ENABLED=false
# ATR_SL_MULT=2.0 MAX_SL_ATR=3.0 TP1_R=1.0 (chốt 50%, tự học chọn lại) TRAIL_ATR_MULT=2.5 TAKER_FEE=0.0005 SLIPPAGE=0.0005
# RISK_PER_TRADE=0.03 (×0.35–1.5 theo AI, co từ lệnh thua thứ 3) MAX_TOTAL_RISK=0.05
# MAX_OPEN_POSITIONS=2 MAX_DAILY_LOSS=0.12 MAX_DRAWDOWN=0.30 LEVERAGE=10 TOP_N_COINS=50
# AI_MIN_CONFIDENCE=60 AI_WEAK_CONFIDENCE=50 AI_VETO_CONF=(trống: chạy ảo 65, chạy thật 0) AI_MAX_CALLS_PER_DAY=80
# AI_CANDIDATES_PER_SCAN=3 EXIT_MODE=auto FILL_RECHECK=false LIVE_RISK_TOL=0.2
# LEARN_MIN_SAMPLES=30 LEARN_MIN_DAYS=7 LEARN_MIN_T=2.0 LEARN_EXIT_MIN_SAMPLES=60 LEARN_COOLDOWN_H=48
# DEFAULT_BLOCKS=setup_range,night_session,afternoon_session,climax_volume
# LƯU Ý: nếu panel đang khai RISK_PER_TRADE / MAX_TOTAL_RISK / MAX_DAILY_LOSS / MAX_DRAWDOWN (hồ sơ test gắt cũ),
# MIN_SCORE / BTC_GATE_CHG / DEFAULT_BLOCKS / LEARN_MIN_T từ bản cũ → XOÁ để dùng mặc định.
# Bản 3.3 (chạy ảo + LEARN_MODE=auto) tự đưa tham số bộ tự học của bản cũ về mặc định 1 lần; LEARN_MODE=suggest: đề xuất chờ duyệt.
