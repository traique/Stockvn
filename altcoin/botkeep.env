# ====== BIẾN CHO BOTKEEP – bot v3.2.0 ======
# Nhập trong panel Botkeep → Environment → khung .env (Saved configuration).
# Biến đã lưu hiện dạng TÊN="__BOTKEEP_KEEP_SECRET_TÊN__": GIỮ NGUYÊN dòng đó để giữ giá trị.
# KHÔNG dán dòng có <...> vào panel – thay <...> bằng giá trị thật, hoặc bỏ dòng đó.
#
# CHỈ CẦN KHAI các biến dưới đây. Mọi thông số giao dịch (MIN_SCORE, TP1_R, rủi ro, ADX…) đã có
# mặc định tốt nhất trong code và tự cập nhật mỗi khi tải zip bản mới → KHÔNG khai trên panel,
# nếu khai thì giá trị trên panel sẽ giữ cố định, không theo bản mới.
# Kiểm tra sau khi restart: log có dòng "Thông số đang dùng: MIN_SCORE=… RISK=…".

# ---------- Chế độ & thông tin riêng ----------
MODE=paper
PAPER_START_BALANCE=10

# ---------- Hồ sơ TEST GẮT (bật 28/10/2026 để thử bản 3.2 với vốn nhỏ) ----------
# 10% vốn mỗi lệnh thay vì 3%; hai lệnh cùng mở tối đa 20%; cầu dao ngày 30%, drawdown 50%.
# Chuỗi 5 lệnh thua liên tiếp sẽ kéo vốn xuống ~40% – chấp nhận khi chạy ảo. Muốn về an toàn: xoá 4 dòng này.
RISK_PER_TRADE=0.10
MAX_TOTAL_RISK=0.20
MAX_DAILY_LOSS=0.30
MAX_DRAWDOWN=0.50
I_UNDERSTAND_THE_RISK=no
INSTANCE_NAME=crypto
TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_URL=https://okx.bot-keep.xyz
SUPPORT_EMAIL=

# ---------- Web dashboard ----------
DASHBOARD_USER=admin
DASHBOARD_PASS=<mật khẩu dashboard>

# ---------- Telegram ----------
TELEGRAM_TOKEN=<token @BotFather>
TELEGRAM_CHAT_ID=<chat id>

# ---------- AI ----------
AI_PROVIDER_ORDER=9router,openrouter
NINEROUTER_BASE_URL=http://node3.botkeep.cloud:36004/v1
NINEROUTER_API_KEY=<sk-uni-... của 9Router>
NINEROUTER_MODEL=auto
OPENROUTER_API_KEY=<key OpenRouter>

# ---------- OKX (chỉ khi chạy thật MODE=live) ----------
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ---------- Zoom Team Chat ----------
ZOOM_CLIENT_ID=<Client ID>
ZOOM_CLIENT_SECRET=<Client Secret>
ZOOM_BOT_JID=<Bot JID>
ZOOM_SECRET_TOKEN=<Secret Token>
# ZOOM_ACCOUNT_ID: để trống/xoá – bot tự lấy từ Zoom (KHÔNG điền "Account No." 10 chữ số ở zoom.us/account)
ZOOM_ACCOUNT_ID=
# Tuỳ chọn: JID nhận thông báo cố định (chỉ khi nút "Gửi thử" trên web vẫn báo lỗi)
ZOOM_TO_JID=

# ---------- Postgres dùng chung trên Supabase (tuỳ chọn; trống = SQLite trên server) ----------
# Chạy song song Render: không dùng – đã bỏ Render (không khai PEER_URL).
DATABASE_URL=

# ---------- TUỲ CHỌN (chỉ thêm khi muốn khác mặc định) ----------
# Mặc định trong code bản này (v3.2): MIN_SCORE=5.0 MIN_ADX=20 HTF_MIN_ADX=18 MAX_EXT_ATR=1.0 MIN_VOL_RATIO=0.7
# BTC_GATE_CHG=0.3 CHASE_1H_PCT=0.5 CLIMAX_VOL=1.5 LATE_TREND_ADX=35
# TP1_R=1.0 (tự học chọn lại) RISK_PER_TRADE=0.03 (×0.35–1.5 theo AI, co từ lệnh thua thứ 3) MAX_TOTAL_RISK=0.05
# MAX_OPEN_POSITIONS=2 MAX_DAILY_LOSS=0.12 MAX_DRAWDOWN=0.30 LEVERAGE=10 TOP_N_COINS=50
# AI_MIN_CONFIDENCE=60 AI_WEAK_CONFIDENCE=50 AI_MAX_CALLS_PER_DAY=80 AI_CANDIDATES_PER_SCAN=3 EXIT_MODE=auto
# LEARN_MIN_SAMPLES=30 LEARN_MIN_T=2.0 LEARN_EXIT_MIN_SAMPLES=60 LEARN_COOLDOWN_H=48
# DEFAULT_BLOCKS=setup_range,night_session,afternoon_session,climax_volume
# LƯU Ý: nếu panel đang khai RISK_PER_TRADE / MIN_SCORE / BTC_GATE_CHG / DEFAULT_BLOCKS / LEARN_MIN_T từ bản cũ → XOÁ để dùng mặc định mới.
# Bản 3.2 tự đưa tham số bộ tự học của bản cũ (chặn short_side, exit trail, MIN_SCORE 5.5, trọng số trigger) về mặc định 1 lần khi khởi động.
