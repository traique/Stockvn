# ─── AI: thứ tự dự phòng 9Router -> Groq -> OpenRouter -> Grok (giống bot Lan Anh) ───
# Nhà cung cấp chưa có key thì tự bỏ qua. Cần ít nhất một nhà cung cấp.
PROVIDER_ORDER=router9,groq,openrouter,xai
ROUTER9_BASE_URL=https://your-9router.example.com/v1
ROUTER9_API_KEY=
ROUTER9_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Grok (xAI), tuỳ chọn
XAI_API_KEY=
XAI_MODEL=grok-4-fast
# Model trên 9Router cho từng tầng (bỏ trống = ROUTER9_MODEL). Tầng deep dùng cho
# Research Manager và Portfolio Manager, tầng quick cho các agent còn lại.
QUICK_MODEL=
DEEP_MODEL=
# Thời gian nghỉ khi bị 429 (nếu nhà cung cấp không gửi Retry-After) và khi 9Router lỗi
LLM_QUOTA_COOLDOWN_SEC=300
ROUTER9_RETRY_SEC=900
LLM_CALL_TIMEOUT_SEC=120
# Hạn mức để không làm sập 9Router/OpenRouter (đếm theo ngày giờ VN, giữ qua lần khởi động lại):
# tổng số lượt gọi AI mỗi ngày (0 = không giới hạn). Lượt tự động tốn tối đa khoảng 10, /phanbien 1, /phantich khoảng 25
# (/phantich bị từ chối từ đầu khi hạn mức còn lại không đủ 25).
LLM_MAX_CALLS_PER_DAY=60
# Hạn mức riêng từng nhà cung cấp (0 = không giới hạn). OpenRouter mặc định 45, dưới mức 50 lượt/ngày của gói free.
ROUTER9_MAX_CALLS_PER_DAY=0
OPENROUTER_MAX_CALLS_PER_DAY=45
# Số lượt gọi AI chạy cùng lúc (4 analyst không còn gọi dồn 4 yêu cầu một lúc)
LLM_MAX_CONCURRENT=2
# Khoảng nghỉ tối thiểu (giây) giữa hai lượt gọi tới cùng một nhà cung cấp (0 = không nghỉ).
# 9Router chạy sau một tài khoản free (vd chatgpt2api giả lập Codex): nên đặt 20-30.
ROUTER9_MIN_INTERVAL_SEC=0
# 1 = khi mọi nhà cung cấp đang nghỉ vẫn thử gọi (cách cũ, dễ làm sập gateway). Mặc định: báo lỗi ngay.
LLM_TRY_RESTING=0

# ─── Telegram ───
TELEGRAM_TOKEN=
# Telegram id được phép dùng bot (gửi /id cho bot để biết id của bạn), cách nhau dấu phẩy
TELEGRAM_ALLOWED_IDS=
# Nơi gửi báo cáo tự động hằng ngày (bỏ trống = gửi cho TELEGRAM_ALLOWED_IDS)
TELEGRAM_REPORT_CHAT_IDS=

# ─── Trang web ───
# Mật khẩu trang web (BẮT BUỘC: để trống thì trang web bị khoá, chỉ bot Telegram chạy).
# Trình duyệt hỏi tên đăng nhập + mật khẩu: tên gì cũng được, mật khẩu là giá trị này.
WEB_PASSWORD=
# Địa chỉ công khai của trang web, để bot gửi kèm link báo cáo (vd https://abc.botkeep.cloud)
PUBLIC_URL=
# Botkeep tự đặt SERVER_PORT; PORT dùng khi chạy nơi khác
# PORT=8080

# ─── Báo cáo tự động ───
WATCHLIST=FPT,HPG,VCB
# Giờ phân tích watchlist (giờ Việt Nam, thứ Hai - thứ Sáu). Ngày lễ (VNINDEX không có phiên) tự bỏ qua.
DAILY_REPORT_TIME=15:30
# Rổ mã lượt quét 15:30 xét (luôn cộng thêm watchlist): vn100 (mặc định) | vn30 | watchlist.
# Chỉ để tìm cơ hội và gửi AI phản biện; ba tài khoản ảo giữ rổ cũ (UNIVERSE_VN30).
SCAN_UNIVERSE=vn100
# Lượt tự động: Quant Engine xét cả rổ trên (không tốn AI), chỉ DAILY_AI_MAX mã mạnh nhất có hành động
# trong DAILY_AI_ACTIONS mới được gửi AI (0 = không gọi AI ở lượt tự động).
# DAILY_AI_MODE: critic = AI phản biện, 1 lượt gọi mỗi mã (giống bot OKX) | full = chuỗi agent (~25 lượt/mã) | off
DAILY_AI_MODE=critic
DAILY_AI_MAX=5
DAILY_AI_ACTIONS=BUY,SELL
# Giờ bot giao dịch + tự hiệu chỉnh chạy (giờ Việt Nam). Bỏ trống = DAILY_REPORT_TIME nếu sau 15:05,
# ngược lại 15:30. Không bao giờ chạy trước 15:05 (nến ngày chưa chốt): giá trị sớm hơn được nâng lên 15:05.
TRADE_TIME=

# ─── Bot giao dịch (không bao giờ gửi lệnh tới CTCK) ───
# paper  = bot tự giao dịch trên tài khoản ảo (mặc định, nên chạy vài tháng trước)
# signal = như paper + gửi lệnh đề xuất cho tài khoản thật; bạn tự đặt rồi báo /khop
# off    = tắt bot
TRADE_MODE=paper
# Vốn tài khoản ảo (VND)
PAPER_CAPITAL=1000000000
# 1 = giao dịch rổ VN30 + watchlist; 0 = chỉ watchlist
UNIVERSE_VN30=1
# 1 = mỗi tối tự hiệu chỉnh ngưỡng Quant Engine và Động lượng (tối đa 1 thay đổi nhỏ; mỗi 60 phiên dữ liệu kiểm tra
# chỉ dùng một lần, phải thắng hơn 2 lần mức nhiễu); Phòng thủ không tự chỉnh, giữ bộ đã kiểm định
# Các tham số mới 23/10/2026 (breakout_projected_ok, confidence_sell_min, stop_atr_mult, stop_min_pct,
# buy_order_sessions, limit_fill_touch; Phòng thủ: fb_market_daily, fb_market_buffer_pct, fb_momentum_weight)
# nằm trong data/results/quant_params.json, mặc định giữ hành vi cũ; xem BAO_CAO_RA_SOAT_2026-10-23.md mục E.
AUTO_CALIBRATE=1
# Chiến lược cho tín hiệu thật (TRADE_MODE=signal): factor (Phòng thủ, mặc định: 10 mã vốn hoá lớn ít biến động,
# về tiền mặt khi VNINDEX dưới MA200; kiểm định ngoài gói (không tái lập được từ mã ở đây) 2013-2026: 15,6%/năm,
# sụt giảm tối đa -26%; VNINDEX là chỉ số giá nên so sánh có lợi cho chiến lược ~1,5-2,5 điểm %/năm),
# momentum (động lượng VN30, sụt giảm 33-45% ở 2024-2026, tới 50% trên rổ point-in-time) hoặc engine (ít lệnh, rủi ro thấp)
SIGNAL_STRATEGY=factor

# ─── So sánh với sieutinhieu.vn (tuỳ chọn, dùng cá nhân) ───
# 1 = mỗi tối lấy tín hiệu của sieutinhieu.vn cho các mã đang giữ và watchlist RIÊNG của Siêu tín hiệu (/stvtheodoi,
# tối đa 60 mã; mỗi mã một lượt, cách nhau 1,5 giây, tự xưng tên bot, dừng 24 giờ nếu trang từ chối), hiện kèm /nhanh
# và báo cáo tối, và chạy một sổ ảo theo tín hiệu đó (khớp ở giá mở cửa phiên sau, có phí, T+2) để so với các sổ của
# bot. Có danh mục riêng (/stvdanhmuc). Không ảnh hưởng lệnh của bot.
SIEUTINHIEU=0
# Watchlist riêng của Siêu tín hiệu (tối đa 60 mã, cách nhau bằng dấu phẩy). Để trống: 60 mã mặc định (VN30 và 30 mã
# giao dịch nhiều nhất). Sửa bằng /stvtheodoi thì danh sách đó được dùng thay biến này.
STV_WATCHLIST=
# Bản tin sáng gửi vào Zoom (Zoom chưa cài hoặc gửi lỗi thì gửi Telegram), các ngày giao dịch: danh sách tín hiệu
# toàn thị trường phần xem miễn phí (phần còn lại cần Premium), tín hiệu của watchlist riêng, và danh mục của bạn với
# lãi/lỗ thực tế. Giờ HH:MM, phải trước 11:30 (sau 11:30 bản tin của ngày đó bị bỏ). Cần TRADE_MODE khác off:
# với TRADE_MODE=off không có lượt chạy tối lấy tín hiệu, không có bản tin sáng tự động (/stvsang vẫn dùng được).
STV_MORNING_TIME=08:30
# Danh mục của bạn theo sieutinhieu (bạn tự mua, báo /stvkhop): cứ bao nhiêu phút (5-120) bot hỏi trang tín hiệu của
# các mã đang giữ, từ 09:00 tới 17:00 ngày giao dịch, và nhắn khi có tín hiệu BÁN (mỗi tín hiệu một lần).
STV_SCAN_MINUTES=15
# 1 = quét cả 60 mã watchlist trong phiên (mặc định 0: watchlist quét sau giờ đóng cửa 15:15-16:00, vì tín hiệu từng mã
# của trang chỉ có sau ~15:08; quét trong phiên tốn khoảng 2.000 lượt hỏi trang mỗi ngày mà thường không có gì mới).
STV_WATCH_INTRADAY=0
# 1 (mặc định) = trong phiên, bot tự ước tính đổi chiều cho mọi mã đang giữ và watchlist (so giá khớp với mức đổi chiều
# tính từ giá đóng cửa; không hỏi thêm trang) và nhắn khi một mã qua mức, ghi rõ "ước tính của bot". 0 = tắt.
STV_ESTIMATE=1
# 1 (mặc định) = bot tự quét toàn thị trường (các mã thanh khoản cao nhất) bằng cùng cách tính, nhắn danh sách lúc 14:46
# và bản đối chiếu với trang sau 15:15. Chỉ dùng giá công khai, không hỏi thêm trang. 0 = tắt.
STV_MARKET=1
# Số mã thanh khoản cao nhất được quét toàn thị trường (50-500).
STV_MARKET_SIZE=300

# ─── Cảnh báo trong phiên (không gọi AI) ───
# 1 = trong giờ khớp lệnh liên tục, mỗi INTRADAY_INTERVAL_MIN phút đọc giá khớp gần nhất và báo: mã đang giữ
# chạm stop/T1/T2/giá sàn (tài khoản thật ở chế độ signal, và tài khoản ảo Quant Engine), lệnh mua giới hạn
# hôm nay vào vùng mua hoặc đã thủng stop dự kiến, VNINDEX giảm INTRADAY_VNI_DROP_PCT % (và gấp đôi).
INTRADAY_ALERTS=1
INTRADAY_INTERVAL_MIN=15
INTRADAY_VNI_DROP_PCT=2

# ─── Zoom Team Chat (tuỳ chọn, ngang hàng Telegram, giống bot OKX) ───
# Cách cài từng bước: đăng nhập web rồi mở <PUBLIC_URL>/zoom (các URL cần dán vào Marketplace có nút Chép).
# Thông báo, cách 1: Incoming Webhook vào một kênh (trong kênh gõ /inc connect vnbot, dán Endpoint + Token)
ZOOM_WEBHOOK_URL=
ZOOM_WEBHOOK_TOKEN=
# Chatbot: gửi thông báo tới JID đã ghép đôi (hoặc ZOOM_TO_JID) và nhận lệnh tại <PUBLIC_URL>/webhook/zoom.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BOT_JID=
ZOOM_ACCOUNT_ID=
# Secret Token của app (Features → Access): bắt buộc để nhận lệnh. ZOOM_VERIFICATION_TOKEN: cơ chế cũ, chỉ khi app không có Secret Token.
ZOOM_SECRET_TOKEN=
ZOOM_VERIFICATION_TOKEN=
# Tuỳ chọn: JID/email được tự ghép đôi ở tin nhắn đầu (không cần /zoompair)
ZOOM_ALLOWED_USERS=
# Tuỳ chọn: gửi thông báo tới JID này thay cho JID đã ghép đôi. Dùng khi mượn app chatbot của bot OKX chỉ để nhận
# thông báo: điền cùng ZOOM_CLIENT_ID / SECRET / BOT_JID / ACCOUNT_ID như bot OKX, ZOOM_TO_JID = JID bot OKX đang ghép
# đôi (/zoomstatus trên Telegram của bot OKX), và để trống ZOOM_SECRET_TOKEN (lệnh gõ vào app đó vẫn tới bot OKX).
ZOOM_TO_JID=
# Email liên hệ hiện trên /privacy và /support (Zoom yêu cầu trang hỗ trợ có kênh liên hệ)
SUPPORT_EMAIL=

# ─── Hàng đợi ───
# Số lượt phân tích từ web/Telegram được chờ cùng lúc; yêu cầu trùng mã + ngày được gộp
MAX_PENDING=10

# ─── Giới hạn tài nguyên (gói free: 2 GB RAM, 2 GB ổ đĩa) ───
DATA_DIR=data
MAX_DEBATE_ROUNDS=1
MAX_RISK_ROUNDS=1
MAX_TOOL_ROUNDS=8
KEEP_REPORTS=60
CACHE_MAX_AGE_DAYS=3
