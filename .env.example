# ============ CHẾ ĐỘ ============
# paper = chạy ảo (chỉ cần dữ liệu public, KHÔNG cần API key OKX)
# live  = giao dịch thật (cần API key + I_UNDERSTAND_THE_RISK=yes)
MODE=paper
PAPER_START_BALANCE=10
I_UNDERSTAND_THE_RISK=no

# ============ OKX ============
# Tạo tại: OKX > Profile > API > Create API key. Quyền: Trade. KHÔNG bật Withdraw.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# true = dùng tài khoản Demo Trading của OKX (key demo riêng) để test đặt lệnh thật trên sàn ảo
OKX_DEMO=false

# ============ RỦI RO ============
LEVERAGE=10
# v3.1: rủi ro cơ bản 3%/lệnh, nhân với hệ số chất lượng (điểm KT, AI: 0.35–1.5×) và co lại sau chuỗi thua
RISK_PER_TRADE=0.03
RISK_MAX_MULT=1.5
RISK_MIN_MULT=0.35
LOSS_STREAK_CUT=0.7
MAX_OPEN_POSITIONS=2
# Tổng % vốn có thể mất nếu mọi lệnh đang mở cùng chạm SL
MAX_TOTAL_RISK=0.05
# Lot tối thiểu của sàn làm rủi ro thật vượt 2× dự tính → bỏ tín hiệu (vốn nhỏ)
MIN_LOT_RISK_MULT=2.0
MAX_DAILY_LOSS=0.12
MAX_DRAWDOWN=0.30
MIN_RR=1.5
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0
TRAIL_ACTIVATE_R=1.2
MAX_HOLD_HOURS=12

# ============ QUÉT COIN ============
# Để trống = dùng danh sách mặc định (BTC, ETH, stablecoin, token hoá cổ phiếu/vàng/dầu...). Ghi đè nếu muốn.
#EXCLUDE=BTC,ETH,USDC,USDT
TIMEFRAME=15m
HTF_TIMEFRAME=1h
SCAN_INTERVAL=300
MONITOR_INTERVAL=20
MIN_SCORE=5.0
# Cổng bắt buộc của tín hiệu (xem README)
MIN_ADX=20
HTF_MIN_ADX=18
MIN_ATR_PCT=0.35
MIN_VOL_RATIO=0.7
MAX_EXT_ATR=1.0
# SL theo cấu trúc xa hơn MAX_SL_ATR → bỏ tín hiệu (không kéo SL vào giữa râu nến)
MAX_SL_ATR=2.5
# Cổng BTC: BTC giảm/tăng quá % này trong 1h thì cấm long/short altcoin
BTC_GATE_CHG=0.6
# Chống bẫy râu: long phải đóng nến >= 60% biên độ (short <= 40%)
WICK_CLOSE_POS=0.6

# ============ AI ============
# Bot gọi AI tối đa 2 lần / lệnh: 1 lần phân tích trước khi vào, 1 lần tổng kết sau khi đóng.
AI_ENABLED=true
AI_REVIEW_ENABLED=true
AI_MAX_CALLS_PER_DAY=60
AI_MIN_CONFIDENCE=60
AI_LESSONS_IN_PROMPT=5
# Thứ tự provider thử: 9router trước, hết/lỗi thì sang openrouter
AI_PROVIDER_ORDER=9router,openrouter

# --- 9Router (gateway local gom provider free: npm i -g 9router && 9router) ---
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=9router
# Tên model/combo như hiển thị trong dashboard 9Router, cách nhau dấu phẩy (để trống = "auto"). NINEROUTER_MODEL cũng được.
NINEROUTER_MODEL=auto
# 9router trả lời chậm quá số giây này thì bỏ, chuyển sang OpenRouter
NINEROUTER_TIMEOUT=30

# --- OpenRouter (model free trực tiếp, key tại https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# auto = tự dò model ':free' còn sống trên OpenRouter (làm mới 12h, model bị gỡ tự loại). Có thể ghi thêm: auto,google/gemma-4-31b-it:free
OPENROUTER_MODELS=auto
# Khi TẤT CẢ model AI lỗi: score = vẫn vào nếu điểm KT >= AI_FAIL_MIN_SCORE | skip = bỏ qua
# Để trống: chạy ảo = score, chạy thật = skip
AI_FAIL_POLICY=
AI_FAIL_MIN_SCORE=7
# Phủ quyết AI: AI phản đối chỉ có hiệu lực khi chắc >= AI_VETO_CONF %. Phản đối yếu hơn mà điểm KT >= AI_OVERRIDE_MIN_SCORE thì vẫn vào.
# Để trống: chạy ảo = 65, chạy thật = 0 (AI luôn được chặn). Bộ tự học tự chỉnh theo kết quả thực tế.
AI_VETO_CONF=
AI_OVERRIDE_MIN_SCORE=6.5
# Luật chặn sẵn (bộ tự học vẫn theo dõi và tự gỡ nếu thực tế có lãi). Có thể thêm afternoon_session (13h–19h giờ VN), night_session (0h–7h). setup_range = đánh đảo chiều khi đi ngang
DEFAULT_BLOCKS=setup_range,night_session
# AI cùng hướng nhưng confidence < AI_MIN_CONFIDENCE: ≥ AI_WEAK_CONFIDENCE vẫn vào với nửa rủi ro, thấp hơn mới bỏ
AI_WEAK_CONFIDENCE=50
# Số coin quét & số ứng viên hỏi AI mỗi lượt (AI từ chối #1 thì hỏi #2, #3)
TOP_N_COINS=50
AI_CANDIDATES_PER_SCAN=3

# --- Provider OpenAI-compatible khác (Groq, Gemini, Ollama...) – tuỳ chọn, thêm "custom" vào AI_PROVIDER_ORDER ---
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODELS=

# ============ CHẠY SONG SONG RENDER + BOTKEEP (tuỳ chọn) ============
# Postgres dùng chung trên Supabase (free). Trống = SQLite cục bộ, 1 máy.
# Lấy ở Supabase → Connect → Connection string → chọn "Session pooler" (KHÔNG dùng Direct connection, Render không có IPv6)
# Dạng: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Kiểm tra bằng: python check_db.py
DATABASE_URL=
# Tên instance để phân biệt trong log/dashboard (render / botkeep)
INSTANCE_NAME=
# URL public của instance kia, bot ping /health mỗi 4 phút để Render free không ngủ
PEER_URL=
# URL public của chính mình (Render tự cấp RENDER_EXTERNAL_URL nên có thể bỏ trống)
SELF_URL=
# Leader mất liên lạc quá số giây này thì máy kia tiếp quản
LEADER_TTL=90

# ============ TELEGRAM ============
# Tạo bot qua @BotFather, lấy chat id qua @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ============ DASHBOARD ============
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASS=doi-mat-khau-nay

LOG_LEVEL=INFO
# Múi giờ cho log, báo cáo ngày, Telegram
TIMEZONE=Asia/Ho_Chi_Minh

# ============ TỰ HỌC ============
# auto = tự áp dụng thay đổi | suggest = chờ duyệt trên web / Telegram /apply | off = tắt
# Để trống: chạy ảo = auto, chạy thật = suggest
LEARN_MODE=
# Đủ mẫu VÀ khác 0 có ý nghĩa thống kê (|kỳ vọng|/sai số chuẩn ≥ LEARN_MIN_T) mới đổi; mỗi tham số tối đa 1 lần/48h
LEARN_MIN_SAMPLES=30
LEARN_MIN_T=1.3
LEARN_COOLDOWN_H=48
LEARN_WINDOW_DAYS=21
AI_DAILY_REVIEW=true
AI_DAILY_REVIEW_HOUR=7

# ============ CÁCH THOÁT LỆNH ("ăn sóng") ============
# auto = bộ tự học chọn (khởi đầu hybrid) | hybrid = chốt 50% ở 2R rồi bám sóng | fixed = TP cố định | trail = bám sóng toàn bộ
EXIT_MODE=auto
TP1_R=1.0
TP1_FRACTION=0.5
TRAIL_ATR_MULT=2.5
TRAIL_TIGHTEN_R=4.0
TRAIL_ATR_MULT_TIGHT=1.5
STALL_HOURS=4
RUNNER_MAX_HOLD_HOURS=24

# Địa chỉ HTTPS công khai của bot (dùng cho Zoom OAuth callback & các trang chính sách)
PUBLIC_URL=
# Email liên hệ hiện trên /privacy, /support (Zoom yêu cầu có kênh liên hệ)
SUPPORT_EMAIL=

# ============ ZOOM TEAM CHAT (tuỳ chọn, ngang hàng Telegram – theo mô hình repo lananh) ============
# Chatbot: nhận lệnh + gửi thông báo tới JID đã ghép đôi. Cần URL HTTPS (Render) – xem README mục 10.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BOT_JID=
ZOOM_SECRET_TOKEN=
ZOOM_ACCOUNT_ID=
# Cơ chế xác thực cũ, chỉ dùng nếu app không có Secret Token
ZOOM_VERIFICATION_TOKEN=
# Tuỳ chọn: email/JID tự được cấp quyền (không cần /zoompair)
ZOOM_ALLOWED_USERS=
# Tuỳ chọn: Incoming Webhook – gửi thông báo vào 1 kênh Zoom (không cần HTTPS, chạy được trên Botkeep)
ZOOM_WEBHOOK_URL=
ZOOM_WEBHOOK_TOKEN=
